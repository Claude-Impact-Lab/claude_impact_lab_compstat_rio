# Chave da Anthropic — obrigatória.
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Quantidade máxima de itens lidos por fonte RSS (POC — manter baixo).
MAX_RSS_ITEMS=30

# Janela de relevância em horas (descarta posts mais antigos).
MAX_AGE_HOURS=72

# Origens permitidas para CORS (Vite dev default).
ALLOWED_ORIGINS=http://localhost:5173
